<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ config.siteName }}</title>
{% include "frontend/partials/css.njk" %}
  <!-- Solana Web3.js -->
